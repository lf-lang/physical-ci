target Python

preamble {=
    import json
    import numpy as np
    import trossen_arm
    import random
    from evdev import InputDevice, categorize, ecodes
=}

reactor Robot {

    input press_button # str

    output pressed_key # str

    state key_positions 
    state driver

    method move_to_home() {=
        print("Moving to home position")
        self.driver.set_arm_modes(trossen_arm.Mode.position)
        self.driver.set_arm_positions(
            np.zeros(self.driver.get_num_joints() - 1),
            2.0,
            True
        )
        print("Robot is at home position")
    =}

    method close_gripper() {=
        print("Closing gripper")
        self.driver.set_gripper_mode(trossen_arm.Mode.position)
        self.driver.set_gripper_position(0.0, 1.0, True)
        print("Gripper is closed")
    =}

    reaction(startup) {=
        with open("examples/positions.json", "r") as f:
            data = json.load(f)
        self.key_positions = data.get("key_positions", {})
        if not self.key_positions.keys():
            print("No keys found in positions.json!")
            exit(1)

        self.driver = trossen_arm.TrossenArmDriver()
        self.driver.configure(
            trossen_arm.Model.wxai_v0,
            trossen_arm.StandardEndEffector.wxai_v0_follower,
            "192.168.1.2",
            False
        )
        self.move_to_home()
        self.close_gripper()
    =}

    reaction (press_button) -> pressed_key {=
        print(f"Pressing button: {press_button.value}")
        if press_button.value not in self.key_positions:
            exit(1)
        
        positions = self.key_positions[press_button.value]
        if "hover" not in positions or "press" not in positions:
            exit(1)
        
        hover_pos = np.array(positions["hover"])
        press_pos = np.array(positions["press"])
        
        print(f"Moving to hover position above '{press_button.value}' button...")
        self.driver.set_arm_positions(
            hover_pos[:6],
            2.0,
            True
        )
        
        print(f"Pressing the '{press_button.value}' button...")
        self.driver.set_arm_positions(
            press_pos[:6],
            2.0,
            True
        )
        
        print(f"Returning to hover position above '{press_button.value}' button...")
        self.driver.set_arm_positions(
            hover_pos[:6],
            2.0,
            True
        )
        pressed_key.set(press_button.value)
        print(f"Robot: Pressed key: {press_button.value}")
    =}

    
    reaction(shutdown) {=
        print("Shutdown: Moving to home position")
        self.move_to_home()
        self.close_gripper()
        print("Shutdown: Robot is at home position")
        return
    =}
}

reactor InputGenerator {
    input pressed_key # str
    output press_button # str
    state current_rand_key # int
    state iter_count # int

    method generate_rand_key() {=
        rand_key = random.randint(1, 9)
        return rand_key
    =}

    reaction(startup) -> press_button {=
        self.iter_count = 0
        self.current_rand_key = self.generate_rand_key()
        press_button.set(str(self.current_rand_key))
    =}

    reaction(pressed_key) -> press_button {=
        key_num = pressed_key.value.split("KEY_KP")[1]
        print(f"InputGenerator: Pressed keypad: {pressed_key.value} | Key number: {key_num}")
        assert int(key_num) == self.current_rand_key, "Key number does not match current random key"
        self.iter_count += 1
        if self.iter_count >= 3:
            request_stop()
            print("InputGenerator: Requesting stop")
        self.current_rand_key = self.generate_rand_key()
        print(f"InputGenerator: Pressing key: {self.current_rand_key}")
        press_button.set(str(self.current_rand_key))
    =}
}

reactor NumpadReceiver {
    input read_numpad # str
    output pressed_key # str
    state numpad_device # InputDevice
    reaction(startup) {=
        print("NumpadReceiver: Starting")
        self.numpad_device = InputDevice("/dev/input/by-id/usb-Usb_KeyBoard_Usb_KeyBoard-event-kbd")
        print(f"NumpadReceiver: Connected to: {self.numpad_device.name}")
    =}

    reaction(read_numpad) -> pressed_key {=
        for event in self.numpad_device.read_loop():
            if event.type == ecodes.EV_KEY:
                key_event = categorize(event)
                if key_event.keystate == 1:  # Key Down
                    print(f"Key: {key_event.keycode} | ID: {key_event.scancode}")
                    pressed_key.set(key_event.keycode)
                    return
    =}

}

main reactor {
    robot = new Robot()
    input_generator = new InputGenerator()
    numpad_receiver = new NumpadReceiver()
    numpad_receiver.pressed_key -> input_generator.pressed_key after 0
    input_generator.press_button -> robot.press_button
    robot.pressed_key -> numpad_receiver.read_numpad
}